# 本地运行时复制为 .env；云端使用 GitHub Secrets/Variables。不要提交真实值。
ZOTERO_ID=your-numeric-user-id
ZOTERO_KEY=your-read-only-zotero-key
SENDER=sender@example.com
RECEIVER=reader@example.com
SENDER_PASSWORD=your-smtp-authorization-code
SMTP_SERVER=smtp.example.com
OPENAI_API_KEY=your-standard-api-key
OPENAI_API_BASE=https://api.example.com/v1
LLM_MODEL=your-model-name
FEEDBACK_BASE_URL=https://your-worker.your-subdomain.workers.dev
# 必须生成新的随机令牌，至少 32 字符；留空会拒绝运行。
FEEDBACK_API_TOKEN=
# 可选
EASYSCHOLAR_SECRET_KEY=
NCBI_EMAIL=
NCBI_API_KEY=
